{
  "name": "vitefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "____________________BUILD AND RUN______________________________________": "",
    "build": "npm run check && tsc && vite build",
    "start:dev": "vite",
    "start:prod": "vite preview",
    "____________________TESTING___________________________________________": "",
    "test:dev": "vitest",
    "test:prod": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "test:e2e:show-trace": "playwright show-trace",
    "____________________CODEGEN____________________________________________": "",
    "gen": "graphql-codegen --require dotenv/config --config codegen.yml",
    "test:e2e:record": "npx playwright codegen",
    "extract-translations": "npx i18next 'src/**/*.{tsx,ts}' -c i18next-parser.config.ts",
    "____________________LINTING AND FORMATTING_____________________________": "",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:style": "stylelint \"**/*.{css,scss}\"",
    "lint:style:fix": "npm run lint:style -- --fix",
    "ts:check": "tsc --noEmit",
    "check": "npm run lint:style && npm run ts:check && npm run lint",
    "____________________OTHER______________________________________________": "",
    "update": "npx ncu -u && npx rimraf node_modules package-lock.json && npm i --legacy-peer-deps && npm audit fix && npm run check",
    "prepare": "husky",
    "postinstall": "npm run prepare"
  },
  "dependencies": {
    "@apollo/client": "^3.13.4",
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "5.0.5",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-codegen/typescript": "4.1.5",
    "@graphql-codegen/typescript-operations": "4.5.1",
    "@graphql-codegen/typescript-react-apollo": "4.3.2",
    "@tanstack/react-router": "^1.114.24",
    "@tanstack/router-devtools": "^1.114.24",
    "@uiw/react-textarea-code-editor": "^3.1.0",
    "antd": "^5.24.4",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "graphql": "^16.10.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-http-backend": "^3.0.2",
    "npm-check-updates": "^17.1.15",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-markdown": "^10.1.0",
    "runes2": "^1.1.4",
    "superjson": "^2.2.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@jetbrains/eslint-config": "^6.0.4",
    "@playwright/test": "^1.51.1",
    "@tanstack/router-vite-plugin": "^1.114.24",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-comments": "1.0.0",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-no-secrets": "2.2.1",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-sonarjs": "^0.25.1",
    "eslint-plugin-unicorn": "56.0.1",
    "husky": "^9.1.7",
    "i18next-parser": "^9.3.0",
    "sass": "^1.86.0",
    "sharp": "^0.33.5",
    "stylelint": "^16.16.0",
    "stylelint-config-standard": "^37.0.0",
    "svgo": "^3.3.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-image-optimizer": "^1.1.8",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-version-mark": "^0.1.4",
    "vitest": "^3.0.9"
  }
}
